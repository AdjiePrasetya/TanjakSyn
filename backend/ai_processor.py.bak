"""
backend/ai_processor.py
Modul AI untuk pemasangan tanjak menggunakan MediaPipe Face Mesh
"""

import cv2
import mediapipe as mp
import numpy as np
import math
import base64
import time


# ── MediaPipe Setup ───────────────────────────────────────
_mp_face_mesh = mp.solutions.face_mesh
_face_mesh = _mp_face_mesh.FaceMesh(
    static_image_mode=True,
    max_num_faces=1,
    refine_landmarks=True,
    min_detection_confidence=0.1
)


def make_bg_white(img):
    """Ubah background transparan jadi putih agar MediaPipe bisa deteksi wajah"""
    if img.ndim == 3 and img.shape[2] == 4:
        alpha = img[:, :, 3] / 255.0
        rgb   = img[:, :, :3]
        white = np.ones_like(rgb) * 255
        result = (rgb * alpha[:, :, np.newaxis] + white * (1 - alpha[:, :, np.newaxis])).astype(np.uint8)
        return result
    return img


def calculate_head_target_points(landmarks, img_w, img_h, tanjak_ratio, scale, v_offset):
    pt_left     = np.array([landmarks[234].x * img_w, landmarks[234].y * img_h])
    pt_right    = np.array([landmarks[454].x * img_w, landmarks[454].y * img_h])
    pt_forehead = np.array([landmarks[10].x  * img_w, landmarks[10].y  * img_h])

    vec_eye    = pt_right - pt_left
    face_width = np.linalg.norm(vec_eye)
    angle      = np.arctan2(vec_eye[1], vec_eye[0])

    tanjak_w = face_width * scale
    tanjak_h = tanjak_w   * tanjak_ratio

    up_vec    = np.array([ math.sin(angle), -math.cos(angle)])
    right_vec = np.array([ math.cos(angle),  math.sin(angle)])
    down_vec  = -up_vec

    center_bottom = pt_forehead + (down_vec * (tanjak_h * v_offset))
    half_w = tanjak_w / 2

    bl = center_bottom - (right_vec * half_w)
    br = center_bottom + (right_vec * half_w)
    tl = bl + (up_vec * tanjak_h)
    tr = br + (up_vec * tanjak_h)

    return np.float32([tl, tr, bl, br])


def detect_landmarks(img_person):
    """
    Jalankan multi-strategy detection.
    Return (landmarks, strategy_name) atau (None, None)
    """
    orig_h, orig_w = img_person.shape[:2]
    crop_h = int(orig_h * 0.5)
    crop   = img_person[0:crop_h, 0:orig_w]

    strategies = [
        ("CROP_50",  make_bg_white(crop),       crop_h, orig_h),
        ("FULL_IMG", make_bg_white(img_person),  orig_h, orig_h),
    ]

    for name, img_check, check_h, total_h in strategies:
        img_rgb = cv2.cvtColor(img_check, cv2.COLOR_BGR2RGB)
        results = _face_mesh.process(img_rgb)
        if results.multi_face_landmarks:
            lms = results.multi_face_landmarks[0].landmark
            if name == "CROP_50":
                for lm in lms:
                    lm.y = (lm.y * check_h) / total_h
            return lms, name

    return None, None


def create_placeholder_tanjak():
    """Buat tanjak placeholder untuk demo tanpa file aset"""
    h, w = 200, 320
    img = np.zeros((h, w, 4), dtype=np.uint8)
    # Bentuk trapezoid
    pts = np.array([[w//2, 5], [w-10, h-10], [10, h-10]], np.int32)
    cv2.fillPoly(img[:, :, :3], [pts], (20, 10, 100))   # BGR dark maroon
    cv2.fillPoly(img[:, :, 3:4], [pts], (255,))
    cv2.polylines(img[:, :, :3], [pts], True, (0, 180, 220), 3)
    return img


def process_tryon(person_bytes: bytes, tanjak_bytes: bytes,
                  scale: float = 2.6, v_offset: float = 0.35):
    """
    Proses utama: tempel tanjak ke foto orang.
    
    Args:
        person_bytes: bytes gambar orang (any format)
        tanjak_bytes: bytes gambar tanjak PNG transparan
        scale:        skala lebar tanjak relatif lebar wajah
        v_offset:     offset vertikal (seberapa turun tanjak ke dahi)
    
    Returns:
        (result_png_bytes, info_dict)  atau  raises ValueError
    """
    t0 = time.time()

    # Decode images
    pa = np.frombuffer(person_bytes, np.uint8)
    ta = np.frombuffer(tanjak_bytes, np.uint8)

    img_person = cv2.imdecode(pa, cv2.IMREAD_UNCHANGED)
    img_tanjak = cv2.imdecode(ta, cv2.IMREAD_UNCHANGED)

    if img_person is None:
        raise ValueError("Gambar orang tidak dapat dibaca")
    if img_tanjak is None:
        img_tanjak = create_placeholder_tanjak()

    # Pastikan BGRA
    if img_person.ndim == 2:
        img_person = cv2.cvtColor(img_person, cv2.COLOR_GRAY2BGRA)
    elif img_person.shape[2] == 3:
        img_person = cv2.cvtColor(img_person, cv2.COLOR_BGR2BGRA)

    if img_tanjak.ndim == 2:
        img_tanjak = cv2.cvtColor(img_tanjak, cv2.COLOR_GRAY2BGRA)
    elif img_tanjak.shape[2] == 3:
        img_tanjak = cv2.cvtColor(img_tanjak, cv2.COLOR_BGR2BGRA)

    orig_h, orig_w = img_person.shape[:2]

    # Deteksi wajah
    landmarks, strategy = detect_landmarks(img_person)
    if landmarks is None:
        raise ValueError("Wajah tidak terdeteksi. Pastikan foto menampilkan wajah dengan jelas dan pencahayaan cukup.")

    # Hitung transformasi perspektif
    h_tj, w_tj   = img_tanjak.shape[:2]
    tanjak_ratio = h_tj / w_tj
    src_pts = np.float32([[0, 0], [w_tj, 0], [0, h_tj], [w_tj, h_tj]])
    dst_pts = calculate_head_target_points(landmarks, orig_w, orig_h, tanjak_ratio, scale, v_offset)

    matrix       = cv2.getPerspectiveTransform(src_pts, dst_pts)
    warped       = cv2.warpPerspective(img_tanjak, matrix, (orig_w, orig_h),
                                       flags=cv2.INTER_LINEAR,
                                       borderMode=cv2.BORDER_CONSTANT,
                                       borderValue=(0, 0, 0, 0))

    # Alpha blending
    alpha     = warped[:, :, 3] / 255.0
    alpha_inv = 1.0 - alpha
    final     = img_person.copy()

    for c in range(3):
        final[:, :, c] = (alpha * warped[:, :, c] + alpha_inv * final[:, :, c]).astype(np.uint8)
    final[:, :, 3] = np.maximum(final[:, :, 3], warped[:, :, 3])

    # Encode ke PNG bytes
    ok, buf = cv2.imencode('.png', final)
    if not ok:
        raise ValueError("Gagal mengenkode gambar hasil")

    proc_time = round(time.time() - t0, 2)

    return buf.tobytes(), {
        "strategy": strategy,
        "proc_time": proc_time,
        "original_size": [orig_w, orig_h],
    }


def bytes_to_b64(b: bytes, mime="image/png") -> str:
    return f"data:{mime};base64," + base64.b64encode(b).decode()
